# ============================================================
#  HR Recruiter — Environment Template
#  Copy this file to `.env` and fill in real values.
#  Commit THIS file; never commit your real `.env`.
# ============================================================

# ---- LLM Provider Configuration ----
# Which provider the graph uses: "ollama" (local, default) or "openai" (hosted / OpenAI-compatible).
MODEL_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_BASE_URL=http://localhost:11434/v1

# ---- Model identifiers ----
LLM_MODEL_NAME=llama3.2:3b
OPENAI_MODEL_NAME=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small

# ---- Generation parameters ----
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000
LLM_REQUEST_TIMEOUT=120

# ---- Screening rules ----
PASS_SCORE_THRESHOLD=60

# ---- Directories (relative paths are resolved from the project root) ----
RESUME_DIR=resumes
SHORTLIST_DIR=shortlisted
REJECTED_DIR=rejected
REPORTS_DIR=reports
PROMPTS_DIR=prompts
DESCRIPTIONS_DIR=descriptions

# ---- Input / output files ----
JOB_DESCRIPTION_FILE=descriptions/job_description.txt
REPORT_FILE=reports/screening_results.csv

# ---- Prompt template files ----
JD_PROMPT_FILE=prompts/read_job_description.txt
RESUME_PROMPT_FILE=prompts/extract_resume_data.txt
SCORE_PROMPT_FILE=prompts/score_candidate.txt
